[Unit]
Description=StudentOS / SmartSlate Backend & Frontend Express Server
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/notepad
ExecStart=/usr/bin/node --max-old-space-size=128 /home/pi/notepad/backend/src/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=5000
Environment=DB_PATH=/home/pi/notepad/backend/src/database/smartslate.db

# Resource & memory caps for Raspberry Pi Zero 2 W (512MB RAM)
MemoryMax=180M
MemoryHigh=150M

[Install]
WantedBy=multi-user.target
